# Public URL of the live site (used for SEO metadata and the sitemap)
NEXT_PUBLIC_SITE_URL=https://www.belloakholdings.co.uk

# Enquiry form email delivery via Resend (https://resend.com)
RESEND_API_KEY=
# Where enquiries are sent (comma-separate for more than one), e.g. ENQUIRY_TO_EMAIL=enquiries@belloakholdings.co.uk
ENQUIRY_TO_EMAIL=
# Sender address on a domain verified in Resend, e.g. ENQUIRY_FROM_EMAIL="Bell Oak Website <website@mail.belloakholdings.co.uk>"
ENQUIRY_FROM_EMAIL=
